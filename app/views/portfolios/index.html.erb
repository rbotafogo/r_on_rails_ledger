<% content_for :title, "R-on-Rails Ledger — demo home" %>

<div class="space-y-12">
  <section class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
    <div class="space-y-4">
      <p class="text-sm font-medium uppercase tracking-[0.16em] text-[var(--ledger-muted)]">
        Demo for R scientists &amp; Rails developers
      </p>
      <h1 class="max-w-3xl text-4xl font-semibold leading-tight tracking-tight text-[var(--ledger-ink)] sm:text-5xl" style="font-family: 'IBM Plex Serif', Georgia, serif;">
        Keep the science in <span class="text-[var(--ledger-accent)]">R</span>. Ship the product on Rails.
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-[var(--ledger-muted)]">
        This app is a family-office style portfolio stress tester: SQLite holds the ledger,
        a background job calls <strong class="font-medium text-[var(--ledger-ink)]">GNU R through Galaaz</strong>
        (Arrow IPC handoff + Ruby <code class="font-mono text-sm">R.*</code> DSL),
        and Hotwire streams VaR / Expected Shortfall plus Plotly charts back to the page.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <% if @portfolios.any? %>
          <%= link_to "Open demo portfolio →", portfolio_path(@portfolios.first),
                class: "inline-flex rounded-md bg-[var(--ledger-accent)] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[var(--ledger-accent-dark)]" %>
        <% else %>
          <span class="inline-flex rounded-md bg-[var(--ledger-line)] px-4 py-2.5 text-sm font-semibold text-[var(--ledger-muted)]">
            Seed data first (see below)
          </span>
        <% end %>
        <%= link_to "Docs → Ruby DSL", doc_path("ruby-dsl"),
              class: "inline-flex rounded-md border border-[var(--ledger-line)] bg-[var(--ledger-panel)] px-4 py-2.5 text-sm font-medium text-[var(--ledger-ink)] hover:border-[var(--ledger-accent)]" %>
        <a href="#how-it-works" class="inline-flex rounded-md border border-[var(--ledger-line)] bg-[var(--ledger-panel)] px-4 py-2.5 text-sm font-medium text-[var(--ledger-ink)] hover:border-[var(--ledger-accent)]">
          How it works
        </a>
        <a href="#for-r-users" class="inline-flex rounded-md border border-[var(--ledger-line)] bg-[var(--ledger-panel)] px-4 py-2.5 text-sm font-medium text-[var(--ledger-ink)] hover:border-[var(--ledger-accent)]">
          For R users
        </a>
      </div>
    </div>

    <aside class="rounded-xl border border-[var(--ledger-line)] bg-[var(--ledger-panel)] p-5 shadow-sm">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-[var(--ledger-muted)]">Try this now</h2>
      <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-[var(--ledger-ink)]">
        <li>Open the demo portfolio.</li>
        <li>Choose <strong>Local R</strong> (Arrow IPC + DSL) or <strong>Docker dual-R</strong> (3.6.3 ∥ 4.3.3).</li>
        <li>Click <strong>Run stress test</strong> — KPIs + Plotly update without a full reload.</li>
      </ol>
      <p class="mt-4 text-xs leading-relaxed text-[var(--ledger-muted)]">
        Seed with <code class="font-mono">SEED_PROFILE=fast</code> (laptop) or <code class="font-mono">wow</code> (~1M bars).
        Pitch script: <%= link_to "runbook", doc_path("runbook"), class: "text-[var(--ledger-accent)] hover:underline" %>.
        Dev jobs use Active Job <code class="font-mono">:async</code> so Turbo works with <code class="font-mono">bin/rails s</code>.
      </p>
    </aside>
  </section>

  <section id="how-it-works" class="scroll-mt-8 space-y-4">
    <h2 class="text-2xl font-semibold tracking-tight" style="font-family: 'IBM Plex Serif', Georgia, serif;">Architecture at a glance</h2>
    <p class="max-w-3xl text-[var(--ledger-muted)]">
      One Rails 8 app. No Redis, no Python microservices, no React SPA. R stays a separate GNU R process
      behind the Galaaz bridge.
    </p>

    <div class="overflow-x-auto rounded-xl border border-[var(--ledger-line)] bg-[var(--ledger-panel)] p-4 sm:p-6">
      <pre class="min-w-[40rem] whitespace-pre font-mono text-xs leading-6 text-[var(--ledger-ink)] sm:text-sm">Browser (Hotwire / Turbo / Plotly)
        │
        ▼
Puma (CRuby) ── Active Record ── SQLite ledger
        │
        └── StressTestJob (Active Job)
                │
                ├── load returns from SQLite
                ├── hand panel to GNU R (Galaaz)
                ├── VaR 95/99 + Expected Shortfall + density
                └── Turbo Stream → update dashboard</pre>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <div class="rounded-xl border border-[var(--ledger-line)] bg-[var(--ledger-panel)] p-4">
        <h3 class="font-semibold text-[var(--ledger-ink)]">Rails owns</h3>
        <p class="mt-2 text-sm text-[var(--ledger-muted)]">HTTP, pages, buttons, job lifecycle, SQLite tables, live UI updates.</p>
      </div>
      <div class="rounded-xl border border-[var(--ledger-line)] bg-[var(--ledger-panel)] p-4">
        <h3 class="font-semibold text-[var(--ledger-ink)]">Galaaz owns</h3>
        <p class="mt-2 text-sm text-[var(--ledger-muted)]">Talking to out-of-process GNU R (NewBridge). Not a reimplementation of CRAN math.</p>
      </div>
      <div class="rounded-xl border border-[var(--ledger-line)] bg-[var(--ledger-panel)] p-4">
        <h3 class="font-semibold text-[var(--ledger-ink)]">R owns</h3>
        <p class="mt-2 text-sm text-[var(--ledger-muted)]">Quantiles, density, Monte Carlo GBM — called from Ruby via Galaaz.</p>
      </div>
    </div>
  </section>

  <section class="grid gap-8 lg:grid-cols-2">
    <div id="for-r-users" class="scroll-mt-8 space-y-3">
      <h2 class="text-2xl font-semibold tracking-tight" style="font-family: 'IBM Plex Serif', Georgia, serif;">If you know R</h2>
      <ul class="list-disc space-y-2 pl-5 text-[var(--ledger-muted)]">
        <li>You are not rewriting VaR in Ruby — the job calls R.</li>
        <li>Read <code class="font-mono text-xs text-[var(--ledger-ink)]">app/jobs/stress_test_job.rb</code> and <code class="font-mono text-xs text-[var(--ledger-ink)]">app/services/risk/</code>.</li>
        <li>In-app docs: <%= link_to "For R scientists", doc_path("for-r-scientists"), class: "font-medium text-[var(--ledger-accent)] hover:underline" %>
          · <%= link_to "Ruby DSL & code", doc_path("ruby-dsl"), class: "font-medium text-[var(--ledger-accent)] hover:underline" %>.</li>
      </ul>
    </div>
    <div class="space-y-3">
      <h2 class="text-2xl font-semibold tracking-tight" style="font-family: 'IBM Plex Serif', Georgia, serif;">If you know Rails</h2>
      <ul class="list-disc space-y-2 pl-5 text-[var(--ledger-muted)]">
        <li>Treat R like an external analytics engine with a Ruby API.</li>
        <li>Don’t block Puma on long R work — enqueue the job (already wired).</li>
        <li>In-app docs: <%= link_to "For Ruby developers", doc_path("for-ruby-developers"), class: "font-medium text-[var(--ledger-accent)] hover:underline" %>
          · <%= link_to "all guides", docs_path, class: "font-medium text-[var(--ledger-accent)] hover:underline" %>.</li>
      </ul>
    </div>
  </section>

  <section class="space-y-4">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 class="text-2xl font-semibold tracking-tight" style="font-family: 'IBM Plex Serif', Georgia, serif;">Portfolios</h2>
      <% if @price_count %>
        <p class="text-sm text-[var(--ledger-muted)]"><%= number_with_delimiter(@price_count) %> price bars in SQLite</p>
      <% end %>
    </div>

    <% if @portfolios.empty? %>
      <div class="rounded-xl border border-amber-300/80 bg-amber-50 p-5 text-amber-950">
        <p class="font-semibold">No portfolios yet</p>
        <p class="mt-2 text-sm">From the app directory:</p>
        <pre class="mt-3 overflow-x-auto rounded-md bg-white/80 p-3 font-mono text-xs">SEED_PROFILE=fast bin/rails db:seed</pre>
        <p class="mt-2 text-xs text-amber-900/80">Use <code class="font-mono">SEED_PROFILE=wow</code> for ~1M rows (see <%= link_to "Data and seeding", doc_path("data-and-seeding"), class: "underline" %>).</p>
      </div>
    <% else %>
      <ul class="divide-y divide-[var(--ledger-line)] overflow-hidden rounded-xl border border-[var(--ledger-line)] bg-[var(--ledger-panel)]">
        <% @portfolios.each do |portfolio| %>
          <li class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <%= link_to portfolio.name, portfolio, class: "text-lg font-semibold text-[var(--ledger-ink)] hover:text-[var(--ledger-accent)]" %>
              <p class="mt-1 text-sm text-[var(--ledger-muted)]">
                <%= number_to_currency(portfolio.total_value) %> · <%= portfolio.assets.count %> assets
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <%= link_to "View ledger", portfolio, class: "rounded-md border border-[var(--ledger-line)] px-3 py-2 text-sm font-medium hover:border-[var(--ledger-accent)]" %>
              <%= button_to "Run (local)",
                    portfolio_stress_tests_path(portfolio),
                    params: { runtime: "local" },
                    class: "rounded-md bg-[var(--ledger-accent)] px-3 py-2 text-sm font-semibold text-white hover:bg-[var(--ledger-accent-dark)]" %>
              <%= button_to "Run (Docker)",
                    portfolio_stress_tests_path(portfolio),
                    params: { runtime: "docker" },
                    class: "rounded-md border border-[var(--ledger-line)] px-3 py-2 text-sm font-medium hover:border-[var(--ledger-accent)] #{@docker_status&.images_ready ? '' : 'opacity-60'}" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="rounded-xl border border-[var(--ledger-line)] bg-[var(--ledger-panel)] p-5">
    <h2 class="text-lg font-semibold" style="font-family: 'IBM Plex Serif', Georgia, serif;">Phase roadmap (this demo)</h2>
    <ul class="mt-3 grid gap-2 text-sm text-[var(--ledger-muted)] sm:grid-cols-2">
      <li><span class="font-semibold text-[var(--ledger-accent)]">Phase 1–3 (now):</span> dual engines, Arrow + DSL, pitch/runbook polish</li>
      <li><span class="font-semibold text-[var(--ledger-ink)]">Later (Phase 4):</span> Pluggy ingest, auth</li>
      <li><span class="font-semibold text-[var(--ledger-ink)]">Docs:</span> <%= link_to "Implementation plan", doc_path("implementation-plan"), class: "text-[var(--ledger-accent)] hover:underline" %>
        · <%= link_to "Pitch script", doc_path("runbook"), class: "text-[var(--ledger-accent)] hover:underline" %></li>
      <li><span class="font-semibold text-[var(--ledger-ink)]">Honest claims:</span> <%= link_to "Architecture", doc_path("architecture"), class: "text-[var(--ledger-accent)] hover:underline" %> (no fake zero-copy)</li>
    </ul>
  </section>
</div>
