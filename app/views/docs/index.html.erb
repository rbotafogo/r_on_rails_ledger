<% content_for :title, "Documentation — R-on-Rails Ledger" %>

<div class="space-y-8">
  <header class="space-y-3">
    <p class="text-sm font-medium uppercase tracking-[0.16em] text-[var(--ledger-muted)]">In-app docs</p>
    <h1 class="text-4xl font-semibold tracking-tight" style="font-family: 'IBM Plex Serif', Georgia, serif;">
      Documentation
    </h1>
    <p class="max-w-2xl text-lg text-[var(--ledger-muted)]">
      Same content as the repo <code class="font-mono text-sm">docs/</code> folder, browseable here —
      plus a <strong class="text-[var(--ledger-ink)]">Ruby DSL &amp; code</strong> tour of the stress-test path.
    </p>
  </header>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= link_to doc_path("ruby-dsl"), class: "block rounded-xl border-2 border-[var(--ledger-accent)] bg-[var(--ledger-panel)] p-5 shadow-sm hover:bg-emerald-50/40" do %>
      <span class="text-xs font-semibold uppercase tracking-wide text-[var(--ledger-accent)]">Start here for code</span>
      <span class="mt-1 block text-xl font-semibold" style="font-family: 'IBM Plex Serif', Georgia, serif;">Ruby DSL &amp; application code</span>
      <span class="mt-2 block text-sm text-[var(--ledger-muted)]">Galaaz call style, concurrent dual engines, live excerpts from this repo.</span>
    <% end %>

    <%= link_to doc_path("architecture"), class: "block rounded-xl border border-[var(--ledger-line)] bg-[var(--ledger-panel)] p-5 hover:border-[var(--ledger-accent)]" do %>
      <span class="text-xs font-semibold uppercase tracking-wide text-[var(--ledger-muted)]">Design</span>
      <span class="mt-1 block text-xl font-semibold" style="font-family: 'IBM Plex Serif', Georgia, serif;">Architecture</span>
      <span class="mt-2 block text-sm text-[var(--ledger-muted)]">Honest claims: Rails shell, Galaaz bridge, no fake zero-copy.</span>
    <% end %>
  </div>

  <section class="space-y-3">
    <h2 class="text-2xl font-semibold" style="font-family: 'IBM Plex Serif', Georgia, serif;">All guides</h2>
    <ul class="divide-y divide-[var(--ledger-line)] overflow-hidden rounded-xl border border-[var(--ledger-line)] bg-[var(--ledger-panel)]">
      <% @pages.each do |page| %>
        <li>
          <%= link_to doc_path(page.slug), class: "flex flex-col gap-1 px-5 py-4 hover:bg-[var(--ledger-bg)] sm:flex-row sm:items-baseline sm:justify-between" do %>
            <span class="font-semibold text-[var(--ledger-ink)]"><%= page.title %></span>
            <span class="text-sm text-[var(--ledger-muted)] sm:max-w-md sm:text-right"><%= page.summary %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</div>
